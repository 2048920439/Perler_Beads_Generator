    "tsyringe": "^4.10.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.5.6"
